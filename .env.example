# Copy to .env and adjust. Every value here has a working default.

# --- apps/api ---
PORT=3001
# Leave MONGO_URL unset to run without a database: planning, drawings and all
# exports still work, and only the /api/projects routes return 503.
# MONGO_URL=mongodb://localhost:27017/shedit
WEB_ORIGIN=http://localhost:3000

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
