{
  "name": "@shedit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.1",
    "@shedit/engine": "workspace:*",
    "@shedit/shared": "workspace:*",
    "mongoose": "9.9.2",
    "pdfkit": "0.19.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.1",
    "@types/pdfkit": "0.17.4",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
